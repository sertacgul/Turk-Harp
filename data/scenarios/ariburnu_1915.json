  "events": [
    {"turn": 1, "type": "message", "popup": true, "who": "19. Tümen Karargâhı, Bigalı", "title": "Arıburnu'na çıkarma!",
     "text": "Kolordu, Kocaçimen'e bir tabur gönderilmesini istiyor. Mustafa Kemal Bey düşmanın ciddi bir kuvvetle çıktığını anlıyor: \"Bir taburla bu iş olmaz.\" Bütün 57. Alay ve dağ bataryası Conkbayırı'na yürüyecek. 57. Alay'ı Bigalı'dan sırtlara sür; 27. Alay Maydos yönünden geliyor."},
    {"turn": 2, "type": "message", "who": "Mustafa Kemal", "text": "Alay, Conkbayırı'na! Kocaçimen'i ve Conkbayırı'nı düşmana bırakmayacağız."},
    {"turn": 3, "type": "message", "popup": true, "who": "Mustafa Kemal ve 8. Bölük askerleri", "title": "\"Cephaneniz yoksa süngünüz var!\"",
     "text": "Conkbayırı'nın güneyinde kıyıdan çekilen askerlere rastlayan Mustafa Kemal sorar: \"Niçin kaçıyorsunuz?\" \"Efendim, düşman!\" \"Nerede?\" \"İşte!\" \"Düşmandan kaçılmaz!\" \"Cephanemiz kalmadı!\" \"Cephaneniz yoksa süngünüz var!\" Askerler süngü takıp yere yattı; düşman da yere yattı. Kazanılan bu zaman, 57. Alay'ın yetişmesini sağladı.", "voice": false},
    {"turn": 3, "type": "morale", "unit": "b8_27", "add": 45},
    {"turn": 3, "type": "shout", "key": "sungu_tak"},
    {"turn": 4, "type": "message", "popup": true, "who": "Mustafa Kemal", "title": "\"Ben size taarruzu emretmiyorum, ölmeyi emrediyorum!\"",
     "text": "\"Biz ölünceye kadar geçecek zaman zarfında yerimize başka kuvvetler ve kumandanlar gelebilir.\" 57. Alay taarruza kalkıyor. Süngü hücumu (B) ile düşman morali ağır sarsılır.", "voice": true},
    {"turn": 4, "type": "morale", "side": "ottoman", "add": 10},
    {"turn": 6, "type": "message", "who": "Gözcüler", "text": "Yeni Zelanda taburları Arıburnu'na çıkıyor; denizdeki zırhlılar sırtları dövüyor."},
    {"turn": 8, "type": "message", "who": "19. Tümen Karargâhı", "text": "77. Alay Kocaçimen'in kuzeyinden yetişti."},
    {"turn": 10, "type": "message", "who": "19. Tümen Karargâhı", "text": "72. Alay'dan bir tabur Büyükanafarta yönünden geliyor."},
    {"turn": 11, "type": "role", "units": ["aif9", "aif10", "aif11", "aif12", "aif5", "aif6", "aif7", "aif8"], "role": "hold"},
    {"turn": 11, "type": "message", "who": "Gözcüler", "text": "Yorgun düşen ANZAC taburları siper kazmaya başladı. Gece çökmeden önce son bir gayret!"},
    {"turn": 13, "type": "role", "units": ["aif1", "aif2", "aif3", "aif4", "nz_auck", "nz_canty", "nz_well", "nz_otago"], "role": "hold"}
  ],
  "triggers": [
    {"when": {"owner": ["Conkbayırı", "entente"]}, "do": [{"type": "message", "popup": true, "who": "Mustafa Kemal", "title": "Conkbayırı düştü!", "text": "Conkbayırı düşman elinde. Gece çökmeden geri alınmazsa bütün yarımada tehlikeye girer. Süngü hücumu ile tepeyi geri al!"}]},
    {"when": {"owner": ["Kocaçimen", "entente"]}, "do": [{"type": "message", "popup": true, "who": "19. Tümen Karargâhı", "title": "Kocaçimen tehlikede!", "text": "Düşman Kocaçimen tepesine ulaştı. Buradan bütün Boğaz görülür; derhal geri alınmalı."}]},
    {"when": {"dead": "hq19"}, "do": [{"type": "message", "popup": true, "who": "Karargâh", "title": "Mustafa Kemal yaralandı", "text": "Komutanımız ağır ateş altında kaldı; karargâh dağıldı. Birliklerin morali sarsıldı. (Karargâhı cephe hattından bir hücre geride tutmak akıllıcadır.)"}]}
